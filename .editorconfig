# Root config
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (used for line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefile requires real tabs
[Makefile]
indent_style = tab
