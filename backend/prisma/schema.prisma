generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name   String  @db.VarChar(100)
  email  String  @unique @db.VarChar(320)
  handle String  @unique @db.VarChar(30)
  bio    String? @db.VarChar(500)

  passwordHash     String    @db.VarChar(255)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  avatarId String? @unique @db.Uuid
  avatar   Media?  @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlistItems Wishlist[]

  @@index([status])
  @@index([role])
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // SHA-256 hash 64 hexadecimal characters.
  tokenHash String @unique @db.Char(64)

  // Identifies all rotated tokens belonging to one login session.
  familyId String @db.Uuid

  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  expiresAt DateTime

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([userId, familyId])
  @@index([expiresAt])
}

model ApiKey {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(100)

  keyHash String @unique @db.Char(64)

  scopes String[] @default([])

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  isRevoked Boolean   @default(false)
  revokedAt DateTime?

  expiresAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([isRevoked])
  @@index([expiresAt])
}

model Media {
  id String @id @default(uuid()) @db.Uuid

  url      String
  altText  String? @db.VarChar(255)
  mimeType String? @db.VarChar(100)

  // Product gallery display order
  position Int @default(0)

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  avatarFor User? @relation("UserAvatar")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
}

model Collection {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(160)
  slug        String  @unique @db.VarChar(160)
  description String? @db.VarChar(1000)
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("collections")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(160)
  slug        String  @unique @db.VarChar(160)
  description String? @db.Text
  isActive    Boolean @default(true)

  collections Collection[]
  variants    ProductVariant[]
  media       Media[]
  wishlists   Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id          String  @id @default(uuid()) @db.Uuid
  label       String  @db.VarChar(50)
  isAvailable Boolean @default(true)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate labels for the same product.
  @@unique([productId, label])
  @@index([productId, isAvailable])
  @@map("product_variants")
}

model Wishlist {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Prevent duplicate wishlist entries for the same user and product
  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("wishlists")
}
