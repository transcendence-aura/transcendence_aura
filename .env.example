# Copy this file to .env and fill in real values.

# --- PostgreSQL ---
POSTGRES_USER=aura
POSTGRES_PASSWORD=change_password
POSTGRES_DB=db
POSTGRES_PORT=5432
POSTGRES_URL="postgresql://aura:change_password@postgres:5432/db?schema=public"

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
NODE_ENV=production

# --- Nginx host ports ---
# Default to 80/443. On rootless Podman (school machines), ports below 1024
# are forbidden: override to 8080/8443 in your local .env.
HTTP_PORT=80
HTTPS_PORT=443

# --- GraphQL ---
GRAPHQL_URL=http://backend:3001/graphql

# --- Vault - Local dev only ---
VAULT_ADDR=http://vault:8200
