# Copy this file to .env and fill in real values.

# --- PostgreSQL ---
POSTGRES_USER=aura
POSTGRES_PASSWORD=change_password
POSTGRES_DB=db
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://aura:change_password@postgres:5432/db

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_ACCESS_SECRET=local-development-access-secret-change-me-123456

# --- Backend ---
NODE_ENV=development

# --- Nginx host ports ---
# Default to 80/443. On rootless Podman (school machines), ports below 1024
# are forbidden: override to 8080/8443 in your local .env.
HTTP_PORT=80
HTTPS_PORT=443

# --- Database seed ---
# SEED_MODE: empty (catalog reference + admin) or demo (adds demo data).
# Passwords: 8 characters minimum, never committed. SEED_DEMO_PASSWORD is only
# required in demo mode.
SEED_MODE=empty
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=SecurePassword!
SEED_DEMO_PASSWORD=SecurePassword!

# --- GraphQL ---
GRAPHQL_URL=http://backend:3001/graphql

# --- Vault - Local dev only ---
VAULT_ADDR=http://vault:8200
VAULT_PORT=8200
